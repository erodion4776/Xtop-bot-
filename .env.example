# .env.example
#
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git.

# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PROJECT_ID=your-project-ref

# ── WhatsApp Cloud API ───────────────────────────────
WHATSAPP_ACCESS_TOKEN=EAAG-your-long-lived-token-here
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token-here

# ── AI / LLM Provider ────────────────────────────────
# Works with OpenAI, Groq, Together, OpenRouter, etc.
AI_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ── Database (for local dev / CI) ────────────────────
SUPABASE_DB_PASSWORD=your-db-password-here
