
{
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window"],
    "strict": true
  },
  "lint": {
    "include": ["supabase/functions/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "include": ["supabase/functions/"],
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "tasks": {
    "dev": "supabase functions serve whatsapp-webhook --env-file .env.local --no-verify-jwt",
    "deploy": "supabase functions deploy whatsapp-webhook --no-verify-jwt",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:status": "supabase db diff --schema public",
    "secrets:set": "supabase secrets set --env-file .env.local",
    "lint": "deno lint supabase/functions/",
    "fmt": "deno fmt supabase/functions/",
    "check": "deno check supabase/functions/whatsapp-webhook/index.ts"
  },
  "imports": {
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2.39.0"
  }
}
